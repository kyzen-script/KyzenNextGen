# ===== Kyzen NextGen Backend — Environment Variables =====
# Copy this file to ".env" and fill in real values.
# Do NOT commit the real .env file. These stay SERVER-SIDE only.

# Link4m API token (Link4m shortener / verification) — provided by user
LINK4M_API_TOKEN=6a7aefcdd8cb7165cf3eb9b7

# Link4m shorten API endpoint (v2)
LINK4M_API_URL=https://link4m.co/api-shorten/v2

# Secret used to sign identifier tokens (HMAC). Keep secret, server-side only.
KYZEN_API_SECRET=change-me-to-a-long-random-string

# Admin password for /admin endpoints (optional)
ADMIN_PASSWORD=change-me-admin

# Database file path (SQLite). Default: ./data/kyzen.db
DATABASE_URL=./data/kyzen.db

# Server port
PORT=8080

# Public base URL of this backend (used to build Link4m redirect destination)
# On Ninja sandbox this is replaced by the exposed public URL automatically.
PUBLIC_BASE_URL=http://localhost:8080
